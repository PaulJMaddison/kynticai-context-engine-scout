# ──────────────────────────────────────────────────────────────────────────────
# KynticAI Scout - Docker Compose Environment
# Copy this file to deploy/.env and customise as needed.
# ──────────────────────────────────────────────────────────────────────────────

# ── Platform ─────────────────────────────────────────────────────────────────
# LocalDemo        = local API + optional fictional demo/reference data
# SelfHosted       = customer-controlled production data plane
# ManagedDataPlane = managed production data plane; does not imply control-plane data sharing
# BackendOnly/SaaS remain legacy compatibility values.
PLATFORM_MODE=SelfHosted

# ── Ports ────────────────────────────────────────────────────────────────────
# Published Docker ports bind to localhost by default.
# Set SCOUT_BIND_ADDRESS=0.0.0.0 only for intentional trusted LAN exposure.
SCOUT_BIND_ADDRESS=127.0.0.1
SCOUT_PORT=8080

# ── Browser origin ───────────────────────────────────────────────────────────
# Required by the production-like PostgreSQL profile because Scout's production
# readiness gate accepts exact origins only. Set this to the real HTTPS frontend
# origin for a deployed environment; the default is safe for local proof only.
SCOUT_CORS_ORIGIN=https://localhost

# ── Demo Data ────────────────────────────────────────────────────────────────
# Set to true to seed fictional B2B SaaS demo data on first startup.
SEED_DEMO_DATA=true

# ── Authentication ───────────────────────────────────────────────────────────
# IMPORTANT: Replace this with a secure random string (48+ bytes) for production.
AUTH_SIGNING_KEY=context-layer-development-only-change-before-production
AUTH_ACCESS_TOKEN_MINUTES=120

# ── OpenAPI / Swagger ────────────────────────────────────────────────────────
# Enable Swagger UI at /swagger (disable in production).
ENABLE_OPENAPI=false

# ── PostgreSQL (only used with --profile postgres) ───────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
SCOUT_DB=scout_context_db
