name: CI

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

permissions:
  contents: read

jobs:
  backend:
    name: Backend (build & test)
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup .NET 10.0
        uses: actions/setup-dotnet@v4
        with:
          global-json-file: global.json

      - name: Restore NuGet packages
        run: dotnet restore KynticAI.Scout.slnx

      - name: Build solution (Release, warnings as errors)
        run: dotnet build KynticAI.Scout.slnx --configuration Release --no-restore -warnaserror

      - name: Run local deterministic tests
        run: dotnet test KynticAI.Scout.slnx --configuration Release --no-restore --no-build --logger "trx;LogFileName=test-results.trx" --results-directory ./test-results

      - name: Upload test results
        uses: actions/upload-artifact@v4
        if: always()
        with:
          name: test-results
          path: ./test-results/**/*.trx
          retention-days: 30

  frontend:
    name: Frontend (web, TypeScript SDK, docs site)
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      # The pinned Node.js version for local development is v22.20.0 (see
      # scripts/ensure-node.sh). No .nvmrc or .node-version pin is tracked,
      # so CI uses the same major-minor line via the Node 22 toolchain.
      - name: Setup Node.js 22
        uses: actions/setup-node@v4
        with:
          node-version: 22

      - name: Web - install
        working-directory: apps/web
        run: npm ci

      - name: Web - lint
        working-directory: apps/web
        run: npm run lint

      - name: Web - test
        working-directory: apps/web
        run: npm test

      - name: Web - build
        working-directory: apps/web
        run: npm run build

      - name: TypeScript SDK - install
        working-directory: packages/typescript/scout-sdk
        run: npm ci

      - name: TypeScript SDK - build
        working-directory: packages/typescript/scout-sdk
        run: npm run build

      - name: TypeScript SDK - test
        working-directory: packages/typescript/scout-sdk
        run: npm test

      - name: Docs site - install
        working-directory: docs-site
        run: npm ci

      - name: Docs site - build
        working-directory: docs-site
        run: npm run build

  public-safety:
    name: Public-safety scan
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Scan for forbidden private code or secret markers
        run: bash scripts/public-safety-scan.sh
