name: Release

# Fires only on manually created `v*` tags. In a public repository only
# users with write access can push tags, so this is limited to authorised
# actors. Package publishing (npm/NuGet) is intentionally NOT configured in
# this workflow: public releases are created as a GitHub Release with
# auto-generated notes, and any registry publishing requires separate,
# explicit approval.
on:
  push:
    tags: ['v*']

permissions:
  contents: write

jobs:
  release:
    name: Build, Test & Release
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup .NET 10.0
        uses: actions/setup-dotnet@v4
        with:
          global-json-file: global.json

      - name: Restore NuGet packages
        run: dotnet restore KynticAI.Scout.slnx

      - name: Build solution (Release, warnings as errors)
        run: dotnet build KynticAI.Scout.slnx --configuration Release --no-restore -warnaserror

      - name: Run local deterministic tests
        run: dotnet test KynticAI.Scout.slnx --configuration Release --no-restore --no-build --logger "trx;LogFileName=test-results.trx" --results-directory ./test-results

      - name: Upload test results
        uses: actions/upload-artifact@v4
        if: always()
        with:
          name: test-results
          path: ./test-results/**/*.trx
          retention-days: 30

      - name: Scan for forbidden private code or secret markers
        run: bash scripts/public-safety-scan.sh

      - name: Create GitHub Release
        uses: softprops/action-gh-release@v2
        with:
          generate_release_notes: true
