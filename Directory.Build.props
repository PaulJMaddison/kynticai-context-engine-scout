<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <LangVersion>preview</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <Version>2.10.0</Version>
    <AssemblyVersion>2.10.0.0</AssemblyVersion>
    <FileVersion>2.10.0.0</FileVersion>
    <InformationalVersion>2.10.0</InformationalVersion>
    <Product>KynticAI Scout</Product>
    <Authors>KynticAI</Authors>
    <Company>KynticAI</Company>
    <RepositoryUrl>https://github.com/PaulJMaddison/scout</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/PaulJMaddison/scout</PackageProjectUrl>
    <PackageTags>context-infrastructure;graphql;rest;dotnet;react;semantic-layer;context-engineering;open-core</PackageTags>
    <PackageReleaseNotes>2.10.0 hardens API client key management, aligns legacy REST cross-tenant authorisation with v1 and GraphQL, uses the injected TimeProvider for deterministic token and audit timestamps, protects platform configuration in hosted mode, and keeps hardened GitHub Actions reference workflows intentionally disabled while the account lock remains unresolved.</PackageReleaseNotes>
  </PropertyGroup>
</Project>
