<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <LangVersion>preview</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <Version>2.10.0</Version>
    <AssemblyVersion>2.10.0.0</AssemblyVersion>
    <FileVersion>2.10.0.0</FileVersion>
    <InformationalVersion>2.10.0</InformationalVersion>
    <Product>KynticAI Scout</Product>
    <Authors>KynticAI</Authors>
    <Company>KynticAI</Company>
    <RepositoryUrl>https://github.com/PaulJMaddison/scout</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/PaulJMaddison/scout</PackageProjectUrl>
    <PackageTags>context-infrastructure;graphql;rest;dotnet;react;semantic-layer;context-engineering;open-core</PackageTags>
    <PackageReleaseNotes>2.9.0 completes the public data-plane foundation: hardened cross-tenant authorisation and API surface, SDK fact-value-type compatibility fix, re-enabled CI/CD with a public-safety scan, documented browser proof, connector authoring and marketplace documentation, migration tool and pilot lead-capture docs, a committed OpenAPI export, and a refreshed roadmap and changelog.</PackageReleaseNotes>
  </PropertyGroup>
</Project>
