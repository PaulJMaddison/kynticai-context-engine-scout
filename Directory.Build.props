<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <LangVersion>preview</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <Version>2.11.0</Version>
    <AssemblyVersion>2.11.0.0</AssemblyVersion>
    <FileVersion>2.11.0.0</FileVersion>
    <InformationalVersion>2.11.0</InformationalVersion>
    <Product>KynticAI Scout</Product>
    <Authors>KynticAI</Authors>
    <Company>KynticAI</Company>
    <RepositoryUrl>https://github.com/PaulJMaddison/kynticai-context-engine-scout</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/PaulJMaddison/kynticai-context-engine-scout</PackageProjectUrl>
    <PackageTags>context-infrastructure;graphql;rest;dotnet;react;semantic-layer;context-engineering;open-core</PackageTags>
    <PackageReleaseNotes>2.11.0 separates sales/reference intelligence from the inference-free Scout core, hardens runtime and production boundaries, adds PostgreSQL cross-instance source-event idempotency and Data Protection restart proof coverage, and aligns the APIs, UI, documentation, and product model around Scout Explore, Fortress Prove, and Elite Scale.</PackageReleaseNotes>
  </PropertyGroup>
</Project>
